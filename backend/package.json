{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate up",
    "db:apply-schema": "tsx scripts/apply-schema.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@runrace/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.19.2"
  }
}
