# Required in monorepo — fixes Expo looking for App.js at repo root
EXPO_NO_METRO_WORKSPACE_ROOT=1

# On a physical phone use your PC LAN IP (not localhost). Example:
# Local Wi‑Fi (same house):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Remote testing (Render / cloud):
EXPO_PUBLIC_API_URL=https://your-app.onrender.com
EXPO_PUBLIC_SOCKET_URL=https://your-app.onrender.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps — required for map tiles on Android (and optional on iOS).
# 1. https://console.cloud.google.com → APIs → enable "Maps SDK for Android" + "Maps SDK for iOS"
# 2. Credentials → Create API key → restrict to your app if needed
# 3. Paste key below, then restart Expo with: npx expo start --clear
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
